import { Request, Response, NextFunction } from 'express';
import ApiResponse from '../utils/ApiResponse.js';
// import {{ModelName}} from '../models/{{ModelName}}.js';
// import {{ServiceName}} from '../services/{{ServiceName}}.js';

class {{ControllerName}} {

  /**
   * Display a listing of the resource.
   */
  public async index(req: Request, res: Response, next: NextFunction) {
    try {
      // const page = Number(req.query.page) || 1;
      // const limit = Number(req.query.limit) || 15;
      // const items = await {{ServiceName}}.list(page, limit);
      return ApiResponse.success(res, [], '{{ModelName}}s retrieved successfully');
    } catch (error) {
      next(error);
    }
  }

  /**
   * Store a newly created resource in storage.
   */
  public async store(req: Request, res: Response, next: NextFunction) {
    try {
      // const item = await {{ModelName}}.create(req.body);
      return ApiResponse.success(res, {}, '{{ModelName}} created successfully', 201);
    } catch (error) {
      next(error);
    }
  }

  /**
   * Display the specified resource.
   */
  public async show(req: Request, res: Response, next: NextFunction) {
    try {
      const { id } = req.params;
      // const item = await {{ModelName}}.findByPk(id);
      return ApiResponse.success(res, { id });
    } catch (error) {
      next(error);
    }
  }

  /**
   * Update the specified resource in storage.
   */
  public async update(req: Request, res: Response, next: NextFunction) {
    try {
      const { id } = req.params;
      // await {{ModelName}}.update(req.body, { where: { id } });
      return ApiResponse.success(res, { id }, '{{ModelName}} updated successfully');
    } catch (error) {
      next(error);
    }
  }

  /**
   * Remove the specified resource from storage.
   */
  public async destroy(req: Request, res: Response, next: NextFunction) {
    try {
      const { id } = req.params;
      // await {{ModelName}}.destroy({ where: { id } });
      return ApiResponse.success(res, null, '{{ModelName}} deleted successfully');
    } catch (error) {
      next(error);
    }
  }
}

export default new {{ControllerName}}();
